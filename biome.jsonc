{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Build artifacts and fixtures: their shape is the bundler's business and the fixtures must
    // stay byte-faithful to what Claude Code writes.
    "includes": [
      "**",
      "!apps/server/public/lib",
      "!apps/server/data",
      "!apps/server/tests/fixtures",
      "!apps/tray/ui/dist",
      "!apps/tray/src-tauri/target",
      "!apps/tray/src-tauri/gen"
    ]
  },
  // The style is the one the codebase already had, measured rather than chosen: 2-space indent,
  // single quotes, semicolons, trailing commas. lineWidth 120 sits above the 99th percentile of the
  // existing lines (131 max outside generated code), so the formatter reflows the outliers instead
  // of rewrapping code that was already deliberate.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // The tsconfig sets noUncheckedIndexedAccess, which makes `xs[0]!` the normal way to use an
        // index already proven present — 722 of them. Banning it means either dropping that flag or
        // adding a redundant runtime check at every access.
        "noNonNullAssertion": "off",
        // Concatenation vs template literal is a preference, and 423 rewrites buy nothing.
        "useTemplate": "off",
        // Reordering CSS rules by specificity is a visual change; these six are deliberate overrides.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        // `any` lives at the parser's edges, where the input is a JSONL line whose shape Anthropic
        // owns and changes between releases.
        "noExplicitAny": "off",
        // Fires on the regexes that strip ANSI escapes — which is what they are for.
        "noControlCharactersInRegex": "off",
        // `while ((m = re.exec(s)))` and friends: idiomatic here, and rewriting them is not safer.
        "noAssignInExpressions": "off",
        // Flags `xs.forEach((x) => map.set(...))`, where the returned value is the setter's, unused.
        "useIterableCallbackReturn": "off"
      },
      "a11y": {
        // The only SVG in the repo is the favicon, where a <title> would name the browser tab.
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        // obj['key'] is used deliberately where the key is data rather than an identifier.
        "useLiteralKeys": "off",
        // `a && a.b` is not `a?.b` when the result is used as a value rather than a condition
        // (falsy `a` vs undefined), so the 25 rewrites are a style preference with a real trap in it.
        "useOptionalChain": "off",
        // !important in the stylesheets is deliberate, and its 5 uses are documented at the rule.
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      // A test's stub often is the degenerate case: a generator that throws before its first
      // yield IS the failure under test, and rewriting it to satisfy the rule would test nothing.
      "includes": ["apps/server/tests/**", "apps/tray/tests/**"],
      "linter": { "rules": { "correctness": { "useYield": "off" } } }
    },
    {
      // seedeep's whole claim is that session content never leaves the machine, and the server is
      // where it could. In this half of the codebase the network is an INJECTED dependency, not an
      // ambient global — `update-check.ts` takes a `fetchImpl`, which is what lets a test count the
      // calls rather than trust a comment. Naming `fetch` here is therefore a new outbound
      // capability, and the three files that legitimately hold one are exempted below, by name.
      // The browser client is out of scope on purpose: it fetches its own origin.
      "includes": ["apps/server/src/server/**", "apps/server/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "on",
              "options": {
                "deniedGlobals": {
                  "fetch": "Network is injected here, never ambient: take a `fetchImpl` so a test can count the calls. If this really is a new outbound destination, it is a product decision — exempt the file in biome.jsonc and say why."
                }
              }
            }
          }
        }
      }
    },
    {
      // The four that may. Two HOLD the seam, naming the global once as the default for their own
      // `fetchImpl` parameter: `update-check.ts` (npm's dist-tags) and `notify-webhook.ts` (an
      // address the user typed, and the only outbound destination seedeep does not choose). The
      // other two dial seedeep's own server on loopback — this machine, by construction.
      // Adding a fifth line here is the decision this rule exists to make visible.
      "includes": [
        "apps/server/src/server/update-check.ts",
        "apps/server/src/server/notify-webhook.ts",
        "apps/server/src/server/restart-cmd.ts",
        "apps/server/src/server/own-server.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    }
  ]
}
